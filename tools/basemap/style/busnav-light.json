{
  "version": 8,
  "name": "BusNav Light",
  "metadata": {
    "busnav:purpose": "default daylight presentation",
    "openmaptiles:version": "3.x",
    "busnav:road-schema": 2
  },
  "center": [137.9, 35.8],
  "zoom": 6,
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "mbtiles://{chubu}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f6f3"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": ["match", ["get", "class"], "wood", "#cee0c4", "grass", "#d9e6cf", "farmland", "#e6e7cb", "sand", "#eee3c6", "#ebeee6"],
        "fill-opacity": 0.72
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#b7ddeb"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 8,
      "paint": {
        "line-color": "#87b9d0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2.0]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-color": "#d8d4ce",
        "fill-outline-color": "#bdb8af",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "railways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["in", ["get", "subclass"], ["literal", ["rail", "narrow_gauge", "light_rail", "subway"]]],
      "paint": {
        "line-color": "#6f7478",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 1.4],
        "line-dasharray": [2, 2],
        "line-opacity": 0.8
      }
    },
    {
      "id": "roads-service-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["==", ["get", "class"], "service"],
      "paint": {
        "line-color": "#b7b5ac",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 2.24, 8, 2.45, 12, 3.05, 16, 5, 18, 7.4, 20, 11, 22, 15.5]
